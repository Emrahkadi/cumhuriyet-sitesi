<%- include('partials/header', { sayfaBaslik: 'Ek Ödenek Tahsilat Raporu' }) %>

<section class="page-hero">
  <div class="container">
    <h1>Ek Ödenek Tahsilat Raporu</h1>
    <p>Şeffaflık: tüm kat maliklerinin ek ödenek ödeme durumu.</p>
  </div>
</section>

<section class="section">
  <div class="container">

    <% if (!plan) { %>
      <div class="admin-panel-box">
        <p class="empty-state">Henüz ek ödenek planı oluşturulmamış.</p>
      </div>
    <% } else { %>

      <%
        // Mobil "Bina Bina" sekmesi icin blok bazli gruplama.
        // Satirlar zaten blok/daire duzeninde gelir.
        var _blokGruplari = [];
        var _blokMap = {};
        satirlar.forEach(function (s) {
          var _b = String(s.blok || '').trim() || 'Diğer';
          if (!_blokMap[_b]) {
            _blokMap[_b] = { blok: _b, satirlar: [], odenen: 0, kalan: 0 };
            _blokGruplari.push(_blokMap[_b]);
          }
          _blokMap[_b].satirlar.push(s);
          _blokMap[_b].odenen += s.odenen_tutar;
          _blokMap[_b].kalan += s.kalan_tutar;
        });
      %>

      <!-- ============ ÖZET KARTLARI ============ -->
      <div class="rapor-ozet-grid">
        <div class="rapor-ozet">
          <span class="rapor-ozet-ikon">💰</span>
          <span class="rapor-ozet-label">Toplam Tahsilat</span>
          <span class="rapor-ozet-deger rapor-yesil"><%= ozet.toplam_tahsilat.toLocaleString('tr-TR', { minimumFractionDigits: 2 }) %> ₺</span>
          <span class="rapor-ozet-alt"><%= ozet.taksit_adet %> taksit ödendi</span>
        </div>
        <div class="rapor-ozet">
          <span class="rapor-ozet-ikon">📋</span>
          <span class="rapor-ozet-label">Toplam Tahakkuk</span>
          <span class="rapor-ozet-deger"><%= ozet.toplam_tahakkuk.toLocaleString('tr-TR', { minimumFractionDigits: 2 }) %> ₺</span>
          <span class="rapor-ozet-alt"><%= ozet.malik_sayisi %> kat malikine tahakkuk</span>
        </div>
        <div class="rapor-ozet">
          <span class="rapor-ozet-ikon">⏳</span>
          <span class="rapor-ozet-label">Kalan</span>
          <span class="rapor-ozet-deger rapor-kirmizi"><%= ozet.kalan.toLocaleString('tr-TR', { minimumFractionDigits: 2 }) %> ₺</span>
          <span class="rapor-ozet-alt"><%= ozet.bekleyen_adet %> taksit bekliyor</span>
        </div>
        <div class="rapor-ozet">
          <span class="rapor-ozet-ikon">👥</span>
          <span class="rapor-ozet-label">Ödeme Yapan</span>
          <span class="rapor-ozet-deger"><%= ozet.odeme_yapan %> / <%= ozet.malik_sayisi %></span>
          <span class="rapor-ozet-alt">Tahsilat oranı <%= ozet.oran.toFixed(1) %>%</span>
        </div>
      </div>

      <!-- ============ İLERLEME ÇUBUĞU ============ -->
      <div class="admin-panel-box">
        <h2>Genel Tahsilat İlerlemesi</h2>
        <div class="rapor-progress">
          <div class="rapor-progress-bar" style="width: <%= Math.min(ozet.oran, 100).toFixed(1) %>%"></div>
        </div>
        <p class="rapor-progress-yazi">
          <strong><%= ozet.oran.toFixed(1) %>%</strong> tahsil edildi
          (<%= ozet.toplam_tahsilat.toLocaleString('tr-TR', { minimumFractionDigits: 2 }) %> ₺ /
          <%= ozet.toplam_tahakkuk.toLocaleString('tr-TR', { minimumFractionDigits: 2 }) %> ₺)
        </p>
      </div>

      <!-- ============ TAKSİT BAZLI ÖZET ============ -->
      <% if (taksitOzet.length) { %>
        <div class="admin-panel-box">
          <h2>Taksit Bazlı Tahsilat</h2>
          <div class="rapor-taksit-grid">
            <% taksitOzet.forEach(function(t) { %>
              <div class="rapor-taksit">
                <span class="rapor-taksit-no"><%= t.sira %>. Taksit</span>
                <span class="rapor-taksit-tutar"><%= t.tutar.toLocaleString('tr-TR', { minimumFractionDigits: 2 }) %> ₺</span>
                <span class="rapor-taksit-sayi"><%= t.odenen %> kişi ödedi</span>
                <% if (t.bekleyen > 0) { %>
                  <span class="rapor-taksit-bekleyen"><%= t.bekleyen %> kişi bekliyor</span>
                <% } else { %>
                  <span class="rapor-taksit-tamam">Tamamlandı</span>
                <% } %>
              </div>
            <% }); %>
          </div>
        </div>
      <% } %>

      <!-- ============ ANA TABLO: AD SOYAD | BLOK | DAIRE | 4 TAKSIT ============ -->
      <div class="admin-panel-box rapor-genel-tablo">
        <h2>
          Kat Maliki Ödeme Durumu
          <small class="rapor-plan-etiket">📋 <%= plan.ad %></small>
        </h2>

        <% if (satirlar.length) { %>
          <%
            // Blok adini normalize et: "A Bloku" -> "A"
            function blokAdi(b) {
              return String(b || '').trim().replace(/\s*Bloku\s*$/i, '');
            }
            // Filtre dropdown'lari icin benzersiz blok listesi
            var _blokListesi = [];
            var _blokSet = {};
            satirlar.forEach(function (s) {
              var _b = blokAdi(s.blok);
              if (_b && !_blokSet[_b]) {
                _blokSet[_b] = true;
                _blokListesi.push(_b);
              }
            });
            _blokListesi.sort();
          %>
          <div class="rapor-filtre-bar" id="raporFiltreBar">
            <div class="rapor-filtre">
              <label for="filtreBlok">Blok</label>
              <select id="filtreBlok" data-filtre="blok">
                <option value="">Tümü (<%= _blokListesi.length %>)</option>
                <% _blokListesi.forEach(function (b) { %>
                  <option value="<%= b %>"><%= b %></option>
                <% }); %>
              </select>
            </div>
            <div class="rapor-filtre">
              <label for="filtreDurum">Durum</label>
              <select id="filtreDurum" data-filtre="durum">
                <option value="">Tümü</option>
                <option value="tamam">✅ Tamamlandı</option>
                <option value="kismi">⏳ Kısmi Ödeme</option>
                <option value="odenmedi">❌ Ödenmedi</option>
              </select>
            </div>
            <form class="rapor-filtre rapor-filtre-arama" id="filtreAramaForm" onsubmit="return false;">
              <label for="filtreArama">Ad, Daire veya Blok</label>
              <div class="rapor-filtre-arama-satir">
                <input type="search" id="filtreArama" data-filtre="arama" placeholder="🔍 Ara..." autocomplete="off">
                <button type="submit" class="btn btn-primary btn-sm" id="filtreAraBtn">Ara</button>
              </div>
            </form>
            <div class="rapor-filtre-eylem">
              <button type="button" class="btn btn-ghost btn-sm" id="filtreSifirla">↺ Sıfırla</button>
              <span class="rapor-filtre-sayi" id="filtreSayi"><%= satirlar.length %> / <%= satirlar.length %> kayıt</span>
            </div>
          </div>
        <% } %>

        <% if (!satirlar.length) { %>
          <p class="empty-state">Kayıt bulunmuyor.</p>
        <% } else { %>
          <div class="table-wrap ek-tablo-wrap">
            <table class="admin-table responsive-table ek-tablo rapor-tablo">
              <thead>
                <tr>
                  <th rowspan="2" class="rapor-sol-baslik">AD SOYAD</th>
                  <th rowspan="2" class="rapor-sol-baslik">BLOK</th>
                  <th rowspan="2" class="rapor-sol-baslik">DAİRE</th>
                  <% taksitOzet.forEach(function(t) { %>
                    <th colspan="2" class="rapor-taksit-baslik">
                      <%= t.sira %>. TAKSİT
                      <span><%= t.tutar.toLocaleString('tr-TR', { minimumFractionDigits: 0 }) %> ₺</span>
                    </th>
                  <% }); %>
                  <th rowspan="2" class="rapor-toplam-baslik">ÖDEDİĞİ</th>
                  <th rowspan="2" class="rapor-toplam-baslik">KALAN</th>
                  <th rowspan="2" class="rapor-toplam-baslik">DURUM</th>
                </tr>
                <tr>
                  <% taksitOzet.forEach(function(t) { %>
                    <th class="rapor-alt-baslik">Durum</th>
                    <th class="rapor-alt-baslik">Tarih</th>
                  <% }); %>
                </tr>
              </thead>
              <tbody>
                <% satirlar.forEach(function(s) { %>
                  <% var _durum = s.tamamlandi ? 'tamam' : (s.odenen_tutar > 0 ? 'kismi' : 'odenmedi'); %>
                  <% var _aramaMetni = ((s.ad_soyad || '') + ' ' + (s.blok || '') + ' ' + (s.daire || '')).toLowerCase(); %>
                  <tr data-blok="<%= blokAdi(s.blok) %>" data-durum="<%= _durum %>" data-arama="<%= _aramaMetni %>">
                    <td data-label="Ad Soyad" class="rapor-ad"><%= s.ad_soyad || '—' %></td>
                    <td data-label="Blok" class="rapor-daire"><%= s.blok || '—' %></td>
                    <td data-label="Daire" class="rapor-daire"><%= s.daire || '—' %></td>
                    <% s.taksitler.forEach(function(tk, i) { %>
                      <td data-label="<%= i + 1 %>. Taksit" class="rapor-hucre">
                        <% if (tk) { %>
                          <% if (tk.odendi) { %>
                            <span class="rapor-odendi">✔ Ödendi</span>
                          <% } else { %>
                            <span class="rapor-bekliyor">Bekliyor</span>
                          <% } %>
                        <% } else { %>
                          <span class="rapor-yok">—</span>
                        <% } %>
                      </td>
                      <td data-label="<%= i + 1 %>. Tarih" class="rapor-tarih">
                        <% if (tk && tk.odeme_tarihi) { %>
                          <span title="<%= tk.odeme_tarihi %>"><%= String(tk.odeme_tarihi).split('-').reverse().join('.') %></span>
                        <% } else { %>
                          —
                        <% } %>
                      </td>
                    <% }); %>
                    <td data-label="Ödediği" class="rapor-hucre rapor-odeme-para"><%= s.odenen_tutar.toLocaleString('tr-TR', { minimumFractionDigits: 0 }) %> ₺</td>
                    <td data-label="Kalan" class="rapor-hucre <%= s.kalan_tutar > 0 ? 'rapor-kirmizi-para' : 'rapor-yesil-para' %>">
                      <%= s.kalan_tutar.toLocaleString('tr-TR', { minimumFractionDigits: 0 }) %> ₺
                    </td>
                    <td data-label="Durum" class="rapor-hucre">
                      <% if (s.tamamlandi) { %>
                        <span class="badge badge-onayli">Tamamlandı</span>
                      <% } else if (s.odenen_tutar > 0) { %>
                        <span class="badge badge-bekliyor">Kısmi</span>
                      <% } else { %>
                        <span class="badge badge-onemli">Ödenmedi</span>
                      <% } %>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
              <tfoot>
                <tr>
                  <td colspan="3" class="rapor-toplam-baslik"><strong>TOPLAM</strong></td>
                  <% taksitOzet.forEach(function(t) { %>
                    <td class="rapor-hucre rapor-alt-baslik"><strong><%= t.odenen %> / <%= t.toplam %></strong></td>
                    <td class="rapor-tarih"></td>
                  <% }); %>
                  <td class="rapor-hucre rapor-odeme-para"><strong><%= ozet.toplam_tahsilat.toLocaleString('tr-TR', { minimumFractionDigits: 0 }) %> ₺</strong></td>
                  <td class="rapor-hucre rapor-kirmizi-para"><strong><%= ozet.kalan.toLocaleString('tr-TR', { minimumFractionDigits: 0 }) %> ₺</strong></td>
                  <td></td>
                </tr>
              </tfoot>
            </table>
          </div>
        <% } %>
      </div>

      <!-- ============ MÖBİL GÖRİNÜM: BİNA BİNA + GENEL LİSTE ============ -->
      <div class="rapor-mobil-sekmeler" role="tablist" aria-label="Rapor görénüm">
        <button type="button" class="rapor-sekme aktif" id="sekmeBina" role="tab" aria-selected="true" aria-controls="panelBina" data-sekme="bina">🏢 Bina Bina</button>
        <button type="button" class="rapor-sekme" id="sekmeListe" role="tab" aria-selected="false" aria-controls="panelListe" data-sekme="liste">📋 Genel Liste</button>
      </div>

      <!-- Bina Bina: her blok icindeki malikler -->
      <div class="rapor-sekme-panel aktif" id="panelBina" role="tabpanel" aria-labelledby="sekmeBina">
        <% if (_blokGruplari.length) { %>
          <% _blokGruplari.forEach(function (g) { %>
            <div class="rapor-bina-blok">
              <div class="rapor-bina-blok-ust">
                <span class="rapor-bina-blok-ad"><%= g.blok %> Bloku</span>
                <span class="rapor-bina-blok-ozet"><%= g.satirlar.length %> kat maliki</span>
                <span class="rapor-bina-blok-ozet rapor-yesil-para"><%= g.odenen.toLocaleString('tr-TR', { minimumFractionDigits: 0 }) %> ₺</span>
                <span class="rapor-bina-blok-ozet <%= g.kalan > 0 ? 'rapor-kirmizi-para' : 'rapor-yesil-para' %>"><%= g.kalan.toLocaleString('tr-TR', { minimumFractionDigits: 0 }) %> ₺ kalan</span>
              </div>
              <div class="rapor-bina-blok-liste">
                <% g.satirlar.forEach(function (s) { %>
                  <%- include('partials/rapor-mobil-kart', { s: s }) %>
                <% }); %>
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <p class="empty-state">Kayıt bulunmuyor.</p>
        <% } %>
      </div>

      <!-- Genel Liste: tum malikler tek liste -->
      <div class="rapor-sekme-panel" id="panelListe" role="tabpanel" aria-labelledby="sekmeListe" hidden>
        <% if (satirlar.length) { %>
          <div class="rapor-genel-liste">
            <% satirlar.forEach(function (s) { %>
              <%- include('partials/rapor-mobil-kart', { s: s }) %>
            <% }); %>
          </div>
        <% } else { %>
          <p class="empty-state">Kayıt bulunmuyor.</p>
        <% } %>
      </div>

      <!-- ============ BLOK BAZLI ÖZET ============ -->
      <% if (blokOzet.length) { %>
        <div class="admin-panel-box rapor-blok-tablo">
          <h2>Blok Bazlı Tahsilat</h2>
          <div class="table-wrap">
            <table class="admin-table responsive-table">
              <thead>
                <tr><th>Blok</th><th>Kat Maliki</th><th>Tahakkuk</th><th>Tahsilat</th><th>Kalan</th><th>Ödeme Yapan</th></tr>
              </thead>
              <tbody>
                <% blokOzet.forEach(function(b) { %>
                  <tr>
                    <td data-label="Blok"><strong><%= b.blok %></strong></td>
                    <td data-label="Kat Maliki"><%= b.adet %></td>
                    <td data-label="Tahakkuk"><%= b.tahakkuk.toLocaleString('tr-TR', { minimumFractionDigits: 0 }) %> ₺</td>
                    <td data-label="Tahsilat"><%= b.tahsilat.toLocaleString('tr-TR', { minimumFractionDigits: 0 }) %> ₺</td>
                    <td data-label="Kalan"><%= (b.tahakkuk - b.tahsilat).toLocaleString('tr-TR', { minimumFractionDigits: 0 }) %> ₺</td>
                    <td data-label="Ödeme Yapan"><%= b.odenen_kisi %> / <%= b.adet %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      <% } %>

      <p style="color:var(--metin-acik); font-size:0.85rem; margin-top:16px; text-align:center;">
        ℹ️ Bu sayfa şeffaflık amacıyla yayımlanmaktadır. Ödeme kayıtları yalnızca site yönetimi tarafından güncellenir.
      </p>
    <% } %>
  </div>
</section>

<!-- Rapor filtreleme (blok / durum anında, arama Ara butonu / Enter ile) -->
<script>
(function () {
  var bar = document.getElementById('raporFiltreBar');
  if (!bar) return;
  var satirToplam = 0;
  var tbody = document.querySelector('.rapor-tablo tbody');
  if (tbody) {
    satirToplam = tbody.querySelectorAll('tr').length;
  }
  var sayac = document.getElementById('filtreSayi');
  var sifirla = document.getElementById('filtreSifirla');
  var aramaForm = document.getElementById('filtreAramaForm');
  var aramaInput = document.getElementById('filtreArama');
  var aramaBtn = document.getElementById('filtreAraBtn');
  var blokSel = document.getElementById('filtreBlok');
  var durumSel = document.getElementById('filtreDurum');

  function uygula() {
    var blok = (blokSel && blokSel.value) || '';
    var durum = (durumSel && durumSel.value) || '';
    var arama = ((aramaInput && aramaInput.value) || '').toLowerCase().trim();
    var gosterilen = 0;
    if (!tbody) return;
    var satirlar = tbody.querySelectorAll('tr');
    satirlar.forEach(function (tr) {
      var trBlok = tr.getAttribute('data-blok') || '';
      var trDurum = tr.getAttribute('data-durum') || '';
      var trArama = tr.getAttribute('data-arama') || '';
      var ok = true;
      if (blok && trBlok !== blok) ok = false;
      if (durum && trDurum !== durum) ok = false;
      if (arama && trArama.indexOf(arama) === -1) ok = false;
      tr.style.display = ok ? '' : 'none';
      if (ok) gosterilen++;
    });
    if (sayac) sayac.textContent = gosterilen + ' / ' + satirToplam + ' kayıt';
  }

  // Blok ve Durum: aninda filtrele
  if (blokSel) blokSel.addEventListener('change', uygula);
  if (durumSel) durumSel.addEventListener('change', uygula);

  // Arama: sadece Ara butonu veya Enter ile
  function aramaTetikle(e) {
    if (e) e.preventDefault();
    uygula();
  }
  if (aramaBtn) aramaBtn.addEventListener('click', aramaTetikle);
  if (aramaForm) aramaForm.addEventListener('submit', aramaTetikle);

  if (sifirla) {
    sifirla.addEventListener('click', function () {
      if (blokSel) blokSel.value = '';
      if (durumSel) durumSel.value = '';
      if (aramaInput) aramaInput.value = '';
      uygula();
    });
  }
})();
</script>

<!-- Mobil rapor sekmeleri (Bina Bina / Genel Liste) -->
<script>
(function () {
  var sekmeler = document.querySelectorAll('.rapor-sekme');
  if (!sekmeler.length) return;
  sekmeler.forEach(function (btn) {
    btn.addEventListener('click', function () {
      var hedef = btn.getAttribute('data-sekme');
      sekmeler.forEach(function (b) {
        var aktif = b === btn;
        b.classList.toggle('aktif', aktif);
        b.setAttribute('aria-selected', aktif ? 'true' : 'false');
      });
      document.querySelectorAll('.rapor-sekme-panel').forEach(function (p) {
        var goster = p.id === (hedef === 'bina' ? 'panelBina' : 'panelListe');
        p.classList.toggle('aktif', goster);
        if (goster) { p.removeAttribute('hidden'); }
        else { p.setAttribute('hidden', ''); }
      });
    });
  });
})();
</script>

<%- include('partials/footer') %>
