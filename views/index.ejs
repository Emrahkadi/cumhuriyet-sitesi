<%- include('partials/header', { sayfaBaslik: 'Ana Sayfa' }) %>

<section class="hero hero-image">
  <div class="hero-overlay"></div>
  <div class="container hero-inner">
    <div class="hero-content">
      <span class="hero-badge">Hoş Geldiniz</span>
      <h1>Cumhuriyet Sitesi<br />Resmi Yönetim Portalı</h1>
      <p>Güncel duyurular, site yönetimi hizmetleri ve site sakinlerine özel üyelik alanı tek bir çatı altında. Modern, güvenli ve huzurlu yaşamın adresi.</p>
      <div class="hero-actions">
        <% if (typeof uye === 'undefined' || !uye) { %>
          <a href="/kayit" class="btn btn-primary">Üye Ol</a>
          <a href="/giris" class="btn btn-outline">Giriş Yap</a>
        <% } else { %>
          <a href="/panel" class="btn btn-primary">Panelim</a>
        <% } %>
        <a href="/duyurular" class="btn btn-outline">Duyuruları Gör</a>
      </div>
    </div>
    <div class="hero-visual">
      <div class="hero-card">
        <span class="hero-card-icon">🏢</span>
        <h3>Site Yönetimi</h3>
        <p>Şeffaf ve erişilebilir yönetim anlayışı</p>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head">
      <h2>Güncel Duyurular</h2>
      <a href="/duyurular" class="section-link">Tümünü Gör →</a>
    </div>

    <% if (duyurular.length === 0) { %>
      <p class="empty-state">Henüz duyuru bulunmuyor.</p>
    <% } else { %>
      <div class="card-grid">
        <% duyurular.forEach(function(d) { %>
          <article class="duyuru-card">
            <div class="duyuru-card-top">
              <span class="badge badge-<%= d.onemli ? 'onemli' : 'genel' %>"><%= d.onemli ? 'Önemli' : d.kategori %></span>
              <time><%= d.olusturma_tarihi.split(' ')[0] %></time>
            </div>
            <h3><a href="/duyuru/<%= d.id %>"><%= d.baslik %></a></h3>
            <p><%= kisalt(d.icerik, 120) %></p>
            <a href="/duyuru/<%= d.id %>" class="card-link">Devamını oku →</a>
          </article>
        <% }); %>
      </div>
    <% } %>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <div class="section-head">
      <h2>📋 Açık Formlar</h2>
      <a href="/formlar" class="section-link">Tümünü Gör →</a>
    </div>

    <% if (typeof acikFormlar !== 'undefined' && acikFormlar && acikFormlar.length > 0) { %>
      <div class="card-grid">
        <% acikFormlar.forEach(function(f) { %>
          <a href="/form/<%= f.slug %>" class="duyuru-card" style="text-decoration:none;color:inherit;display:block;">
            <div class="duyuru-card-top">
              <span class="badge badge-onemli">✅ Açık</span>
              <time><%= f.olusturma_tarihi.split(' ')[0] %></time>
            </div>
            <h3 style="color:var(--metin-koyu,#1a3a5c);"><%= f.baslik %></h3>
            <% if (f.aciklama) { %>
              <p><%= f.aciklama.length > 100 ? f.aciklama.slice(0, 100) + '…' : f.aciklama %></p>
            <% } %>
            <span class="card-link">Doldurmak için tıklayın →</span>
          </a>
        <% }); %>
      </div>
    <% } else { %>
      <p class="empty-state">Şu anda açık form bulunmuyor.</p>
    <% } %>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="feature-grid">
      <div class="feature-item">
        <span class="feature-icon">📢</span>
        <h3>Anlık Duyurular</h3>
        <p>Site ile ilgili tüm önemli gelişmelerden ilk siz haberdar olun.</p>
      </div>
      <div class="feature-item">
        <span class="feature-icon">👥</span>
        <h3>Üyelik Sistemi</h3>
        <p>Daire numaranız ve telefonunuzla kayıt olun, size özel alana erişin.</p>
      </div>
      <div class="feature-item">
        <span class="feature-icon">🏗️</span>
        <h3>Kentsel Dönüşüm</h3>
        <p>Sitemizin dönüşüm sürecini adım adım takip edin.</p>
      </div>
      <div class="feature-item">
        <span class="feature-icon">💬</span>
        <h3>Canlı Destek</h3>
        <p>Sorularınız için yönetim ile canlı sohbet üzerinden iletişime geçin.</p>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
