<%- include('partials/header', { sayfaBaslik: duyuru.baslik }) %>

<section class="section">
  <div class="container container-narrow">
    <a href="/duyurular" class="back-link">← Tüm duyurular</a>
    <article class="duyuru-detay">
      <div class="duyuru-card-top">
        <span class="badge badge-<%= duyuru.onemli ? 'onemli' : 'genel' %>"><%= duyuru.onemli ? 'Önemli' : duyuru.kategori %></span>
        <time><%= duyuru.olusturma_tarihi %></time>
      </div>
      <h1><%= duyuru.baslik %></h1>
      <div class="duyuru-icerik"><%- duyuru.icerik %></div>
      <% if (duyuru.ek_dosya) { %>
        <p class="ek-dosya">
          📎 <a href="<%= duyuru.ek_dosya %>" target="_blank" rel="noopener">Ek dosyayı indir / görüntüle</a>
        </p>
      <% } %>
    </article>
  </div>
</section>

<%- include('partials/footer') %>
