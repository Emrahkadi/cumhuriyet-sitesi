<%- include('partials/header', { sayfaBaslik: 'Üye Ol' }) %>

<%
  // JS için blok -> daire listesi haritası (sayılar)
  var dairelerMap = {};
  (daireler || []).forEach(function(d) {
    dairelerMap[d.blok] = d.secenekler;
  });
%>
<script id="daireler-data" type="application/json"><%- JSON.stringify(dairelerMap) %></script>
<script>
  (function(){
    function bagla(){
      var blokSel = document.getElementById('blok_select');
      var daireSel = document.getElementById('daire');
      var data = document.getElementById('daireler-data');
      if (!blokSel || !daireSel || !data) return;
      var harita;
      try { harita = JSON.parse(data.textContent); } catch(e) { return; }
      function guncelle(){
        var blok = blokSel.value;
        daireSel.innerHTML = '';
        if (!blok || !harita[blok]) {
          var o0 = document.createElement('option');
          o0.value = ''; o0.textContent = 'Önce blok seçin';
          daireSel.appendChild(o0);
          daireSel.disabled = true;
          return;
        }
        var oi = document.createElement('option');
        oi.value = ''; oi.textContent = '— Daire —';
        daireSel.appendChild(oi);
        harita[blok].forEach(function(n){
          var o = document.createElement('option');
          o.value = String(n); o.textContent = String(n);
          daireSel.appendChild(o);
        });
        daireSel.disabled = false;
      }
      blokSel.addEventListener('change', guncelle);
      blokSel.addEventListener('input', guncelle);
      if (blokSel.value) guncelle();
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bagla);
    else bagla();
  })();
</script>

<section class="section">
  <div class="container">
    <div class="auth-wrap">
      <div class="auth-card">
        <h1>Üye Ol</h1>
        <p class="auth-sub">Daire bilgilerinizle kayıt olun. E-postanıza gelen kodla üyeliğinizi doğrulayın, sonra yönetici onayı beklenir.</p>
        <form action="/kayit" method="POST" class="form">
          <div class="form-group">
            <label for="ad_soyad">Ad Soyad</label>
            <input type="text" id="ad_soyad" name="ad_soyad" required />
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="blok_select">Blok</label>
              <select id="blok_select" name="blok" required>
                <option value="">— Seçin —</option>
                <% (daireler || []).forEach(function(d) { %>
                  <option value="<%= d.blok %>"><%= d.etiket %> blok</option>
                <% }); %>
              </select>
            </div>
            <div class="form-group">
              <label for="daire">Daire</label>
              <select id="daire" name="daire" required disabled>
                <option value="">Önce blok seçin</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label for="telefon">Telefon Numarası</label>
            <input type="tel" id="telefon" name="telefon" placeholder="05__ ___ __ __" required />
          </div>
          <div class="form-group">
            <label for="email">E-posta <span class="zorunlu">*</span></label>
            <input type="email" id="email" name="email" placeholder="ornek@email.com" required />
            <small>Şifre sıfırlama bu e-postaya gönderilecek.</small>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="sifre">Şifre</label>
              <input type="password" id="sifre" name="sifre" required />
            </div>
            <div class="form-group">
              <label for="sifre_tekrar">Şifre (Tekrar)</label>
              <input type="password" id="sifre_tekrar" name="sifre_tekrar" required />
            </div>
          </div>
          <button type="submit" class="btn btn-primary btn-block">Kayıt Ol</button>
        </form>
        <p class="auth-alt">Zaten üye misiniz? <a href="/giris">Giriş yapın</a></p>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
