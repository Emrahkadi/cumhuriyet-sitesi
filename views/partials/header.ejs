<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#1e5aa8" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Cumhuriyet" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="application-name" content="Cumhuriyet Sitesi" />
  <meta name="msapplication-TileColor" content="#1e5aa8" />
  <meta name="description" content="Cumhuriyet Sitesi resmi web sitesi - duyurular, iletişim, kentsel dönüşüm ve site sakinleri üyelik portalı." />
  <title><%= typeof sayfaBaslik !== 'undefined' ? sayfaBaslik + ' - ' : '' %>Cumhuriyet Sitesi</title>
  <link rel="manifest" href="/manifest.json" />
  <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png" />
  <link rel="icon" type="image/png" sizes="512x512" href="/icons/icon-512.png" />
  <link rel="apple-touch-icon" sizes="192x192" href="/icons/icon-192.png" />
  <link rel="apple-touch-icon" sizes="512x512" href="/icons/icon-512.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css?v=18" />
  <script>
    // PWA Service Worker kaydı
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', function() {
        navigator.serviceWorker.register('/sw.js').then(function(reg) {
          console.log('[PWA] Service Worker kayıtlı:', reg.scope);
          window.__swReg = reg;
        }, function(err) {
          console.warn('[PWA] Service Worker kaydı başarısız:', err);
        });
      });
    }

    // Web Push bildirim yönetimi
    window.PushBildirim = (function() {
      const DESTEK = 'serviceWorker' in navigator && 'PushManager' in window && 'Notification' in window;
      let izinDurumu = DESTEK ? Notification.permission : 'denied';

      async function publicKeyAl() {
        const r = await fetch('/api/vapid-public-key');
        const j = await r.json();
        return j.publicKey;
      }

      async function aboneOl() {
        if (!DESTEK) return { basarili: false, hata: 'Tarayıcı desteklemiyor.' };
        if (izinDurumu === 'default') {
          izinDurumu = await Notification.requestPermission();
        }
        if (izinDurumu !== 'granted') {
          return { basarili: false, hata: 'Bildirim izni verilmedi.' };
        }
        const reg = await navigator.serviceWorker.ready;
        let abone = await reg.pushManager.getSubscription();
        if (!abone) {
          const key = await publicKeyAl();
          abone = await reg.pushManager.subscribe({
            userVisibleOnly: true,
            applicationServerKey: urlBase64ToUint8Array(key)
          });
        }
        const r = await fetch('/api/push/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ subscription: abone.toJSON() })
        });
        const j = await r.json();
        return { basarili: !!j.basarili };
      }

      async function aboneliktenCik() {
        if (!DESTEK) return { basarili: false };
        const reg = await navigator.serviceWorker.ready;
        const abone = await reg.pushManager.getSubscription();
        if (!abone) return { basarili: true };
        const endpoint = abone.endpoint;
        await abone.unsubscribe();
        await fetch('/api/push/unsubscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ endpoint })
        });
        return { basarili: true };
      }

      async function durum() {
        if (!DESTEK) return { destek: false, izin: 'denied', abone: false };
        const izin = Notification.permission;
        let abone = false;
        if (izin === 'granted' && navigator.serviceWorker.controller) {
          const reg = await navigator.serviceWorker.ready;
          abone = !!(await reg.pushManager.getSubscription());
        }
        return { destek: true, izin, abone };
      }

      function urlBase64ToUint8Array(b64) {
        const padding = '='.repeat((4 - b64.length % 4) % 4);
        const base64 = (b64 + padding).replace(/-/g, '+').replace(/_/g, '/');
        const raw = atob(base64);
        const out = new Uint8Array(raw.length);
        for (let i = 0; i < raw.length; ++i) out[i] = raw.charCodeAt(i);
        return out;
      }

      return { destek: DESTEK, aboneOl, aboneliktenCik, durum };
    })();
  </script>
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="logo">
        <img src="/images/logo.png?v=2" alt="Cumhuriyet Sitesi" class="logo-img" />
        <span class="logo-text">Cumhuriyet <strong>Sitesi</strong></span>
      </a>

      <button type="button" class="nav-toggle" id="navToggle" aria-label="Menü" aria-expanded="false" aria-controls="mainNav" onclick="var n=document.getElementById('mainNav'),o=n.classList.contains('open');n.classList[o?'remove':'add']('open');this.setAttribute('aria-expanded',o?'false':'true');">
        <span></span><span></span><span></span>
      </button>

      <nav class="main-nav" id="mainNav">
        <a href="/" class="<%= aktifSayfa === 'anasayfa' ? 'active' : '' %>">Ana Sayfa</a>
        <a href="/duyurular" class="<%= aktifSayfa === 'duyurular' ? 'active' : '' %>">Duyurular</a>
        <a href="/hakkinda" class="<%= aktifSayfa === 'hakkinda' ? 'active' : '' %>">Hakkımızda</a>
        <a href="/kentsel-donusum" class="<%= aktifSayfa === 'kentsel-donusum' ? 'active' : '' %>">Kentsel Dönüşüm</a>
        <a href="/iletisim" class="<%= aktifSayfa === 'iletisim' ? 'active' : '' %>">İletişim</a>
        <% if (uye) { %>
          <a href="/anketler" class="<%= aktifSayfa === 'anketler' ? 'active' : '' %>">📊 Anketler</a>
        <% } %>

        <% if (uye) { %>
          <div class="nav-bell-wrapper">
            <button type="button" id="navBellBtn" class="nav-bell" title="Mesajlarım" aria-haspopup="true" aria-expanded="false">
              🔔<% if (okunmamisMesajSayisi > 0) { %><span class="nav-badge"><%= okunmamisMesajSayisi %></span><% } %>
            </button>
            <div class="nav-bell-dropdown" id="navBellDropdown" hidden>
              <div class="nav-bell-header">
                <strong>Mesajlarım</strong>
                <a href="/mesajlarim">Tümü →</a>
              </div>
              <% if (okunmamisMesajSayisi === 0) { %>
                <div class="nav-bell-empty">Okunmamış mesaj yok</div>
              <% } else { %>
                <ul class="nav-bell-list">
                  <% okunmamisMesajlar.forEach(function(m) { %>
                    <li>
                      <a href="/mesajlarim#m<%= m.id %>">
                        <strong><%= m.baslik %></strong>
                        <span><%= (m.mesaj || '').replace(/<[^>]+>/g, '').slice(0, 80) %><%= (m.mesaj || '').length > 80 ? '…' : '' %></span>
                        <small><%= m.olusturma_tarihi %></small>
                      </a>
                    </li>
                  <% }); %>
                </ul>
              <% } %>
            </div>
          </div>
          <a href="/panel" class="nav-cta <%= aktifSayfa === 'panel' ? 'active' : '' %>">Panelim</a>
          <button type="button" id="pushToggleBtn" class="nav-push-btn" hidden title="Push bildirimlerini aç/kapat">
            <span class="push-on">🔔 Bildirim Aç</span>
            <span class="push-off">🔕 Bildirim Alınıyor</span>
          </button>
          <a href="/cikis" class="nav-logout">Çıkış</a>
        <% } else { %>
          <a href="/giris" class="nav-cta <%= aktifSayfa === 'giris' ? 'active' : '' %>">Giriş Yap</a>
        <% } %>
      </nav>
    </div>
  </header>

  <% if (basari && basari.length) { %>
    <div class="container"><div class="alert alert-success"><%= basari %></div></div>
  <% } %>
  <% if (hata && hata.length) { %>
    <div class="container"><div class="alert alert-error"><%= hata %></div></div>
  <% } %>

  <div class="nav-overlay" id="navOverlay"></div>
  <main>
  <script>
    // Mobil menü açma/kapama (drawer)
    (function() {
      if (window.__navToggleBound) return;
      window.__navToggleBound = true;
      var tog = document.getElementById('navToggle');
      var nav = document.getElementById('mainNav');
      if (!tog || !nav) return;

      // Kullanıcının niyetine (aria-expanded) göre "open" class'ını
      // koruyan bir watcher. 3rd-party script'lerin (örn. MutationObserver
      // veya başka listener'lar) class'ı geri kaldırmasını engeller.
      // Sadece drawer'ın durumu değiştiğinde kısa bir süre çalışır.
      var rafId = null;
      function enforceState() {
        var wantOpen = tog.getAttribute('aria-expanded') === 'true';
        var hasOpen = nav.classList.contains('open');
        if (wantOpen !== hasOpen) {
          if (wantOpen) nav.classList.add('open');
          else nav.classList.remove('open');
        }
      }
      function startWatching() {
        if (rafId) return;
        var endTime = Date.now() + 1500; // 1.5 saniye izle
        function tick() {
          enforceState();
          if (Date.now() < endTime) {
            rafId = requestAnimationFrame(tick);
          } else {
            rafId = null;
            enforceState(); // son bir kontrol
          }
        }
        rafId = requestAnimationFrame(tick);
      }
      // Toggle tıklandığında watcher'ı başlat
      tog.addEventListener('click', startWatching);
      // Overlay'e (drawer dışına) tıklayınca kapat
      var overlay = document.getElementById('navOverlay');
      if (overlay) {
        overlay.addEventListener('click', function() {
          tog.setAttribute('aria-expanded', 'false');
          enforceState();
        });
      }
      // ESC tuşu ile kapat
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && tog.getAttribute('aria-expanded') === 'true') {
          tog.setAttribute('aria-expanded', 'false');
          enforceState();
        }
      });
      // Ekran büyürse drawer'ı sıfırla
      window.addEventListener('resize', function() {
        if (window.innerWidth > 860) {
          tog.setAttribute('aria-expanded', 'false');
          enforceState();
        }
      });
    })();

    // Bildirim dropdown açma/kapama
    (function() {
      var btn = document.getElementById('navBellBtn');
      var dd = document.getElementById('navBellDropdown');
      if (!btn || !dd) return;
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        var goster = dd.hasAttribute('hidden');
        if (goster) { dd.removeAttribute('hidden'); btn.setAttribute('aria-expanded', 'true'); }
        else { dd.setAttribute('hidden', ''); btn.setAttribute('aria-expanded', 'false'); }
      });
      document.addEventListener('click', function(e) {
        if (!dd.contains(e.target) && e.target !== btn) {
          dd.setAttribute('hidden', '');
          btn.setAttribute('aria-expanded', 'false');
        }
      });
    })();

    // Push bildirim butonu davranışı
    (function() {
      var btn = document.getElementById('pushToggleBtn');
      if (!btn) return;
      if (!window.PushBildirim || !window.PushBildirim.destek) {
        btn.setAttribute('hidden', '');
        return;
      }
      btn.removeAttribute('hidden');

      async function guncelle() {
        var d = await window.PushBildirim.durum();
        btn.classList.remove('abone', 'izin-yok');
        if (d.izin === 'denied') {
          btn.classList.add('izin-yok');
          btn.title = 'Bildirim izni reddedildi. Tarayıcı ayarlarından izin verin.';
        } else if (d.abone) {
          btn.classList.add('abone');
          btn.title = 'Bildirimler açık. Tıklayarak kapatın.';
        } else {
          btn.title = 'Yeni duyurulardan anında haberdar olun.';
        }
      }
      btn.addEventListener('click', async function() {
        var d = await window.PushBildirim.durum();
        if (d.izin === 'denied') {
          alert('Bildirim izni reddedilmiş. Tarayıcı ayarlarından bu site için bildirim iznini açın.');
          return;
        }
        if (d.abone) {
          await window.PushBildirim.aboneliktenCik();
        } else {
          await window.PushBildirim.aboneOl();
        }
        guncelle();
      });
      guncelle();
    })();

    // PWA install banner + iOS için "Add to Home Screen" ipucu
    (function() {
      var kapaliAnahtar = 'pwa-install-banner-kapali';
      var kapatildi = false;
      try { kapatildi = localStorage.getItem(kapaliAnahtar) === '1'; } catch (e) {}
      if (kapatildi) return;
      // Sadece standalone değilse veya ilk ziyarette
      var standalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;
      if (standalone) return;
      // 3 saniye sonra göster (sayfa yüklendikten sonra)
      setTimeout(function() {
        var banner = document.createElement('div');
        banner.className = 'pwa-install-banner';
        banner.id = 'pwaInstallBanner';
        var isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;
        if (isIOS) {
          banner.innerHTML =
            '<span class="pwa-banner-icon">📱</span>' +
            '<div class="pwa-banner-text">' +
              '<strong>Uygulamayı Ana Ekrana Ekleyin</strong>' +
              'Safari paylaş menüsünden <strong>\"Ana Ekrana Ekle\"</strong> seçeneğine dokunun.' +
            '</div>' +
            '<button type="button" class="pwa-banner-close" aria-label="Kapat">×</button>';
        } else {
          banner.innerHTML =
            '<span class="pwa-banner-icon">📲</span>' +
            '<div class="pwa-banner-text">' +
              '<strong>Cumhuriyet Sitesi Uygulaması</strong>' +
              'Hızlı erişim için tarayıcı menüsünden <strong>\"Ana Ekrana Ekle\"</strong> deneyin.' +
            '</div>' +
            '<button type="button" class="pwa-banner-close" aria-label="Kapat">×</button>';
        }
        document.body.appendChild(banner);
        banner.querySelector('.pwa-banner-close').addEventListener('click', function() {
          try { localStorage.setItem(kapaliAnahtar, '1'); } catch (e) {}
          banner.remove();
        });
      }, 3000);
    })();
  </script>
