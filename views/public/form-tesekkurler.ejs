<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>Teşekkürler - Cumhuriyet Sitesi</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    * { box-sizing: border-box; }
    body {
      background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      margin: 0;
      font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }
    .thanks-container {
      max-width: 480px;
      width: 100%;
      background: #fff;
      border-radius: 16px;
      box-shadow: 0 10px 40px rgba(0,0,0,.1);
      padding: 40px 32px;
      text-align: center;
    }
    .thanks-icon { font-size: 4rem; margin-bottom: 16px; }
    .thanks-container h1 {
      margin: 0 0 12px 0;
      font-size: 1.5rem;
      color: #1a3a5c;
      word-break: break-word;
    }
    .thanks-container p {
      color: #6b7c93;
      margin-bottom: 24px;
      line-height: 1.6;
    }
    .thanks-container .btn {
      display: inline-block;
      background: #1a3a5c;
      color: #fff;
      padding: 12px 28px;
      border-radius: 8px;
      text-decoration: none;
      font-weight: 600;
      transition: background .2s;
      min-height: 44px;
      line-height: 20px;
    }
    .thanks-container .btn:hover { background: #0f2640; }

    @media (max-width: 600px) {
      body { padding: 12px; }
      .thanks-container {
        padding: 32px 20px;
        border-radius: 12px;
      }
      .thanks-icon { font-size: 3rem; }
      .thanks-container h1 { font-size: 1.3rem; }
      .thanks-container .btn {
        width: 100%;
        padding: 14px 20px;
      }
    }
  </style>
</head>
<body>
  <div class="thanks-container">
    <div class="thanks-icon">✅</div>
    <h1><%= form.baslik %></h1>
    <p><%= mesaj %></p>
    <a href="/" class="btn">Ana Sayfa</a>
  </div>
</body>
</html>
