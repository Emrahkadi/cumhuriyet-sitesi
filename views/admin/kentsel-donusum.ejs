<%- include('partials/header', { sayfaBaslik: 'Kentsel Dönüşüm' }) %>

<div class="admin-panel-box">
  <h2>Yeni Kayıt Ekle</h2>
  <form action="/yonetim/kentsel-donusum/ekle" method="POST" class="form" enctype="multipart/form-data">
    <div class="form-group">
      <label for="baslik">Başlık</label>
      <input type="text" id="baslik" name="baslik" required />
    </div>
    <div class="form-group">
      <label for="icerik">İçerik</label>
      <textarea id="icerik" name="icerik" rows="4" data-quill placeholder="Kentsel dönüşüm içeriğini yazın..." required></textarea>
    </div>
    <div class="form-group">
      <label for="durum">Durum</label>
      <select id="durum" name="durum">
        <option value="Planlama">Planlama</option>
        <option value="Değerlendirme">Değerlendirme</option>
        <option value="Onay Süreci">Onay Süreci</option>
        <option value="Uygulama">Uygulama</option>
        <option value="Tamamlandı">Tamamlandı</option>
      </select>
    </div>
    <div class="form-group">
      <label for="ek">Ek Dosya (PDF, Excel, görsel — maks 10 MB)</label>
      <input type="file" id="ek" name="ek" accept=".pdf,.xlsx,.xls,.csv,.png,.jpg,.jpeg,.webp,.gif" />
    </div>
    <button type="submit" class="btn btn-primary">Kayıt Ekle</button>
  </form>
</div>

<div class="admin-panel-box">
  <h2>Mevcut Kayıtlar (<%= maddeler.length %>)</h2>
  <% if (maddeler.length === 0) { %>
    <p class="empty-state">Henüz kayıt yok.</p>
  <% } else { %>
    <div class="table-wrap">
      <table class="admin-table">
        <thead>
          <tr><th>Başlık</th><th>Durum</th><th>Tarih</th><th>İşlem</th></tr>
        </thead>
        <tbody>
          <% maddeler.forEach(function(m) { %>
            <tr>
              <td><%= m.baslik %></td>
              <td><span class="badge badge-durum"><%= m.durum %></span></td>
              <td><%= m.olusturma_tarihi.split(' ')[0] %></td>
              <td>
                <form action="/yonetim/kentsel-donusum/sil/<%= m.id %>" method="POST" data-confirm="Bu kayıt silinsin mi?">
                  <button type="submit" class="btn-sil">Sil</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
