<%- include('partials/header', { sayfaBaslik: 'Anket Raporu' }) %>

<div class="admin-panel-box">
  <a href="/yonetim/anketler" class="back-link" style="display:inline-block;margin-bottom:14px;">← Anketlere dön</a>
  <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:12px;">
    <div>
      <h2 style="margin:0;">📊 <%= anket.baslik %></h2>
      <% if (anket.aciklama) { %><p style="color:var(--metin-acik);margin:6px 0 0 0;"><%= anket.aciklama %></p><% } %>
    </div>
    <div>
      <% if (anket.durum === 1) { %><span class="badge badge-onayli">Açık</span><% } else { %><span class="badge badge-bekliyor">Kapalı</span><% } %>
      <% if (anket.gizli) { %><span class="badge badge-durum">🔒 Gizli</span><% } %>
    </div>
  </div>
  <p style="color:var(--metin-acik);font-size:0.88rem;margin-top:10px;">
    Oluşturma: <%= anket.olusturma_tarihi %>
    <% if (anket.bitis_tarihi) { %> · Bitiş: <%= anket.bitis_tarihi %><% } %>
  </p>
</div>

<% if (basari && basari.length) { %><div class="alert alert-success"><%= basari %></div><% } %>
<% if (hata && hata.length) { %><div class="alert alert-error"><%= hata %></div><% } %>

<% if (soruSayisi === 0) { %>
  <div class="admin-panel-box" style="text-align:center;">
    <p style="color:var(--metin-acik);">Bu ankette henüz soru yok.</p>
  </div>
<% } else { %>
  <% sorular.forEach(function(s, idx) { %>
    <div class="admin-panel-box">
      <h3 style="margin-bottom:14px;">Soru <%= idx + 1 %>: <%= s.soru %></h3>
      <div class="rapor-satirlar">
        <% s.dagilim.forEach(function(d) { %>
          <div class="rapor-satir">
            <div class="rapor-satir-baslik">
              <span class="rapor-secenek"><%= d.secenek %></span>
              <span class="rapor-sayi"><%= d.adet %> oy (<%= d.yuzde %>%)</span>
            </div>
            <div class="rapor-bar-disi">
              <div class="rapor-bar-ic" style="width:<%= d.yuzde %>%"></div>
            </div>
          </div>
        <% }); %>
        <div class="rapor-toplam">Toplam: <strong><%= s.toplamOy %></strong> oy</div>
      </div>
    </div>
  <% }); %>
<% } %>

<% if (katilimcilar.length > 0) { %>
  <div class="admin-panel-box">
    <h2 style="margin-bottom:14px;">👥 Katılımcılar ve Verdikleri Oylar (<%= katilimcilar.length %> kişi)</h2>
    <p style="color:var(--metin-acik);font-size:0.85rem;margin-bottom:14px;">
      🔒 Bu bilgiler sadece yönetim tarafından görülebilir. Üyeler kimlerin ne oy verdiğini göremez.
    </p>
    <% katilimcilar.forEach(function(k) { %>
      <details style="margin-bottom:10px;border:1px solid var(--kenarlik);border-radius:10px;padding:10px 14px;background:#fafbfc;">
        <summary style="cursor:pointer;font-weight:600;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;list-style:none;">
          <span>👤 <%= k.ad_soyad %> <span style="color:var(--metin-acik);font-weight:400;font-size:0.85rem;">— Daire <%= k.daire_no %></span></span>
          <span style="color:var(--metin-acik);font-weight:400;font-size:0.82rem;">
            <%= k.cevaplanan_soru %>/<%= soruSayisi %> cevap · <%= k.katilim_tarihi %>
          </span>
        </summary>
        <div style="margin-top:12px;padding-top:12px;border-top:1px solid var(--kenarlik);">
          <% sorular.forEach(function(s, idx) { %>
            <% const secilenIdx = k.oyler[s.id]; %>
            <div style="display:flex;gap:10px;align-items:flex-start;margin-bottom:8px;font-size:0.9rem;">
              <strong style="color:var(--metin-acik);min-width:60px;">S<%= idx + 1 %>:</strong>
              <span>
                <% if (secilenIdx !== undefined && secilenIdx !== null) { %>
                  <%= s.secenekler[secilenIdx] %>
                <% } else { %>
                  <em style="color:var(--metin-acik);">— cevaplanmamış —</em>
                <% } %>
              </span>
            </div>
          <% }); %>
        </div>
      </details>
    <% }); %>
  </div>
<% } else { %>
  <div class="admin-panel-box" style="text-align:center;color:var(--metin-acik);">
    Henüz kimse bu ankete oy vermemiş.
  </div>
<% } %>

<%- include('partials/footer') %>
