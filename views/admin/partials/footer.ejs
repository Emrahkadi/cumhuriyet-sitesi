    </div>
  </main>

  <script src="/js/main.js" defer></script>
  <script src="/js/quill.min.js?v=1.3.7" defer></script>
  <script>
    // Quill editörü: data-quill attribute'lu tüm textarea'ları başlat
    // Quill CDN'den defer ile yüklendiği için DOMContentLoaded sonrası çalışıyoruz.
    function quillBaslat() {
      if (typeof Quill === 'undefined') {
        // CDN yüklenemedi; kullanıcıya bilgi ver ve normal textarea kalsın
        console.warn('Quill yüklenemedi, editör devre dışı.');
        return;
      }
      document.querySelectorAll('textarea[data-quill]').forEach(function(ta) {
        if (ta.dataset.quillReady === '1') return;
        ta.dataset.quillReady = '1';

        // Gizli bir input aynı name ile oluştur, Quill içeriği oraya yazılacak
        var hidden = document.createElement('input');
        hidden.type = 'hidden';
        hidden.name = ta.name;
        hidden.id = ta.id + '_hidden';
        ta.removeAttribute('name');
        ta.removeAttribute('required'); // HTML5 required'i kaldır, server-side kontrolü var
        ta.style.display = 'none';

        var editorDiv = document.createElement('div');
        editorDiv.id = ta.id + '_editor';
        editorDiv.style.minHeight = '180px';
        editorDiv.style.background = '#fff';
        editorDiv.style.marginBottom = '8px';

        // Editörü textarea'nın SONRASINA ekle (görünür olsun)
        ta.parentNode.insertBefore(hidden, ta);
        ta.parentNode.insertBefore(editorDiv, ta.nextSibling);

        var quill = new Quill(editorDiv, {
          theme: 'snow',
          placeholder: ta.getAttribute('placeholder') || 'İçerik yazın...',
          modules: {
            toolbar: [
              [{ 'header': [1, 2, 3, false] }],
              ['bold', 'italic', 'underline', 'strike'],
              [{ 'list': 'ordered' }, { 'list': 'bullet' }],
              [{ 'align': [] }],
              ['link', 'blockquote', 'code-block'],
              ['clean']
            ]
          }
        });

        // Mevcut değeri (EJS ile render edilmiş) editöre yükle
        if (ta.value && ta.value.trim()) {
          quill.root.innerHTML = ta.value;
          hidden.value = ta.value;
        }

        // Her içerik değişikliğinde gizli input'u güncelle (submit'ten önce hazır olsun)
        quill.on('text-change', function() {
          hidden.value = quill.root.innerHTML;
        });

        // Form submit olunca editör içeriğini gizli input'a yaz
        var form = ta.closest('form');
        if (form) {
          form.addEventListener('submit', function() {
            hidden.value = quill.root.innerHTML;
          });
        }
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', quillBaslat);
    } else {
      quillBaslat();
    }
    // Güvenlik: defer script yüklendikten sonra tekrar dene
    window.addEventListener('load', function() {
      if (typeof Quill !== 'undefined') quillBaslat();
    });

    // Sidebar drawer açma/kapama (mobil)
    (function() {
      var tog = document.getElementById('adminSidebarToggle');
      var sb  = document.getElementById('adminSidebar');
      var ovl = document.getElementById('adminOverlay');
      if (!tog || !sb) return;
      function kapat() {
        sb.classList.remove('open');
        if (ovl) ovl.classList.remove('open');
        document.body.classList.remove('menu-open');
        tog.setAttribute('aria-expanded', 'false');
      }
      function ac() {
        sb.classList.add('open');
        if (ovl) ovl.classList.add('open');
        document.body.classList.add('menu-open');
        tog.setAttribute('aria-expanded', 'true');
      }
      tog.addEventListener('click', function(e) {
        e.stopPropagation();
        if (sb.classList.contains('open')) kapat();
        else ac();
      });
      if (ovl) ovl.addEventListener('click', kapat);
      // Sidebar içindeki X kapatma butonu
      var closeBtn = document.getElementById('adminSidebarClose');
      if (closeBtn) closeBtn.addEventListener('click', kapat);
      // Sidebar linki tıklanınca kapat
      sb.querySelectorAll('a').forEach(function(a) {
        a.addEventListener('click', kapat);
      });
      // ESC
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && sb.classList.contains('open')) kapat();
      });
      // Pencere büyüyünce drawer'ı sıfırla
      window.addEventListener('resize', function() {
        if (window.innerWidth > 900) kapat();
      });
    })();
  </script>
</body>
</html>
