<%- include('partials/header', { sayfaBaslik: 'İletişim' }) %>

<section class="page-hero">
  <div class="container">
    <h1>İletişim</h1>
    <p>Görüş, öneri ve talepleriniz için bize ulaşın.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="iletisim-grid">
      <div class="iletisim-bilgi">
        <h2>Site Yönetimi</h2>
        <ul class="iletisim-liste">
          <li><span>📍</span> Yenişehir, 34912 Pendik/İstanbul</li>
          <li><span>📞</span> <a href="tel:+905323083331">+90 532 308 33 31</a> <small>(UFUK USTA)</small></li>
          <li><span>✉️</span> <a href="mailto:info@cumhuriyetsitesi.org">info@cumhuriyetsitesi.org</a></li>
          <li><span>🕐</span> Hafta içi 09:00 - 18:00</li>
        </ul>

        <h2 style="margin-top: 28px;">Yönetim Kurulu</h2>
        <p class="yonetim-hint">Site yönetim kurulu üyeleriyle doğrudan iletişime geçebilirsiniz.</p>
        <ul class="yonetim-kurulu">
          <li>
            <span class="yk-no">1</span>
            <div class="yk-bilgi">
              <strong>Ufuk USTA</strong>
              <a href="tel:+905323083331">+90 532 308 33 31</a>
            </div>
          </li>
          <li>
            <span class="yk-no">2</span>
            <div class="yk-bilgi">
              <strong>Emre DOĞAN</strong>
              <a href="tel:+905418289574">+90 541 828 95 74</a>
            </div>
          </li>
          <li>
            <span class="yk-no">3</span>
            <div class="yk-bilgi">
              <strong>Adem DOĞAN</strong>
              <a href="tel:+905555247977">+90 555 524 79 77</a>
            </div>
          </li>
          <li>
            <span class="yk-no">4</span>
            <div class="yk-bilgi">
              <strong>Emrah KADI</strong>
              <a href="tel:+905061011141">+90 506 101 11 41</a>
            </div>
          </li>
        </ul>

        <div class="iletisim-not">
          <strong>💬 Canlı Destek</strong>
          <p>Sayfanın sağ alt köşesindeki canlı sohbet penceresinden anlık olarak bize ulaşabilirsiniz.</p>
        </div>
      </div>

      <div class="iletisim-form-wrap">
        <h2>Bize Yazın</h2>
        <form action="/iletisim" method="POST" class="form">
          <div class="form-row">
            <div class="form-group">
              <label for="ad_soyad">Ad Soyad *</label>
              <input type="text" id="ad_soyad" name="ad_soyad" required />
            </div>
            <div class="form-group">
              <label for="telefon">Telefon</label>
              <input type="tel" id="telefon" name="telefon" />
            </div>
          </div>
          <div class="form-group">
            <label for="email">E-posta</label>
            <input type="email" id="email" name="email" />
          </div>
          <div class="form-group">
            <label for="konu">Konu</label>
            <input type="text" id="konu" name="konu" />
          </div>
          <div class="form-group">
            <label for="mesaj">Mesajınız *</label>
            <textarea id="mesaj" name="mesaj" rows="5" data-quill placeholder="Mesajınızı yazın..." required></textarea>
          </div>
          <button type="submit" class="btn btn-primary btn-block">Gönder</button>
        </form>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
